{
  "KPackageStructure": "Plasma/Applet",
  "X-Plasma-API-Minimum-Version": "6.0",
  "KPlugin": {
    "Icon": "view-media-lyrics",
    "Id": "com.github.ocelotshark.spotifylyrics",
    "Name": "Spotify Lyrics",
