    "Category": "Multimedia",
    "Authors": [
      {
        "Name": "Wesley Berthelot",
        "Website": "https://github.com/ocelotshark"
      }
    ],
    "Copyright": "© 2026 Wesley Berthelot",
    "License": "MIT",
    "Website": "https://github.com/ocelotshark/plasmoid-spotify-lyrics",
    "BugReportUrl": "https://github.com/ocelotshark/plasmoid-spotify-lyrics/issues"
  },
  "X-Plasma-Provides": [
    "org.kde.plasma.multimediacontrols"
  ]
}
